modules = ["python-3.11"]
[agent]
expertMode = true

[nix]
channel = "stable-25_05"
packages = ["openssl"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "DuckDB dry-run verification"

[[workflows.workflow]]
name = "DuckDB dry-run verification"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python scripts/daily.py --auto-once --offline-fixture --warehouse /tmp/magolide-replit/warehouse.duckdb --localdata /tmp/magolide-replit --notify"
