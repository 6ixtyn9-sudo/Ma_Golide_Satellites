__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.venv/
.env

# Credentials are never source artifacts.
service-account*.json

# DuckDB/CSV state belongs in the bounded orchestration cache, not Git.
# Keep large raw forecast/audit dumps in the workflow cache and downloadable
# Actions artifacts, not Git history. Compact human cards, paper-ticket receipts,
# write-once ticket state, and performance summaries remain durable evidence.
localdata/*
!localdata/*/
localdata/*/*
localdata/*/picks_*.json
localdata/*/picks_audit_*.md
# Dated draft cards, compact lifecycle state, and fixture freezes are
# Git-durable evidence restored by the workflow after cache recovery. Detailed
# dated lifecycle renders remain isolated cache/Actions-artifact evidence.
!localdata/*/picks_????-??-??.json
!localdata/*/pick_lifecycle_state.json
!localdata/*/pick_freeze_*.json
!localdata/*/coverage_gap_*.json
!localdata/*/picks_*.txt
!localdata/*/auto_tickets_*.json
!localdata/*/auto_tickets_*.txt
*.duckdb
*.duckdb.wal
*.tmp

# Test/build outputs.
.coverage
htmlcov/
build/
dist/
*.egg-info/
