__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.venv/
.env

# Credentials are never source artifacts.
service-account*.json

# DuckDB/CSV state belongs in the bounded orchestration cache, not Git.
# Keep large raw forecast/audit dumps in the workflow cache and downloadable
# Actions artifacts, not Git history. Compact human cards, paper-ticket receipts,
# write-once ticket state, and performance summaries remain durable evidence.
localdata/*
!localdata/*/
localdata/*/*
localdata/*/picks_*.json
localdata/*/picks_audit_*.md
# Dated text cards and lifecycle state (including inline immutable fixture
# snapshots) are Git-durable evidence restored by the workflow after cache
# recovery. Structured dated pick JSON, including detailed lifecycle renders,
# remains cache/Actions-artifact evidence for every league.
!localdata/*/pick_lifecycle_state.json
# A fixture snapshot is nested in pick_lifecycle_state.json, never one file per
# date/game; reject stale cache sidecars explicitly.
localdata/*/pick_freeze_*.json
!localdata/*/coverage_gap_*.json
# Checksum/asset pointer for the compact GitHub Release canonical checkpoint.
!localdata/*/archive_manifest.json
!localdata/*/picks_*.txt
!localdata/*/auto_tickets_*.json
!localdata/*/auto_tickets_*.txt
# One count-only ABA history summary is durable evidence. It never contains
# raw source pages, per-game evidence, prices, or ticket state.
!localdata/aba_league/history_receipts.json
# The retired *_preview.txt sidecar was replaced by the draft section inside
# the single dated auto_tickets_YYYY-MM-DD.txt card; do not let a stale cache
# or an old workflow reintroduce it as a tracked artifact.
localdata/*/auto_tickets_*_preview.txt
# No-bet decisions are immutable date locks nested in auto_tickets_state.json,
# not one sidecar per league/date.
localdata/*/auto_tickets_*_no_bet.json
# EuroLeague's separate aggregate-consensus research board preserves a
# time-locked no-stake roster and mutable official-result card in Git.
!localdata/euroleague/euroleague_consensus_paper_*.json
!localdata/euroleague/euroleague_consensus_paper_*.txt
*.duckdb
*.duckdb.wal
*.tmp

# Test/build outputs.
.coverage
htmlcov/
build/
dist/
*.egg-info/
